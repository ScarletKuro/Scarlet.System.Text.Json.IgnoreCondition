<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- CA1711: the "Ex" suffix is deliberate. JsonIgnoreConditionEx mirrors the built-in
         JsonIgnoreCondition and adds to it, and the parallel naming is the point. -->
    <NoWarn>$(NoWarn);CA1711</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Adds WhenReadingNull and WhenReadingDefault to System.Text.Json alongside native ignore conditions, for reflection-based and source-generated serializers including NativeAOT. Includes an analyzer and code fixes for conflicting attributes.</Description>
    <PackageTags>STJ, JsonIgnore, JsonIgnoreCondition, WhenReadingNull, IgnoreNullValues, JsonSerialization, AOT</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../shared/IgnoreConditionRules.cs" Link="Internal/IgnoreConditionRules.cs" />
    <ProjectReference Include="../Scarlet.System.Text.Json.IgnoreCondition.Analyzers/Scarlet.System.Text.Json.IgnoreCondition.Analyzers.csproj"
                      PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="../Scarlet.System.Text.Json.IgnoreCondition.Analyzers.CodeFixes/Scarlet.System.Text.Json.IgnoreCondition.Analyzers.CodeFixes.csproj"
                      PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <InternalsVisibleTo Include="Scarlet.System.Text.Json.IgnoreCondition.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="_AddAnalyzersToPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="../Scarlet.System.Text.Json.IgnoreCondition.Analyzers/bin/$(Configuration)/netstandard2.0/$(AssemblyName).Analyzers.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="../Scarlet.System.Text.Json.IgnoreCondition.Analyzers.CodeFixes/bin/$(Configuration)/netstandard2.0/$(AssemblyName).Analyzers.CodeFixes.dll" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
