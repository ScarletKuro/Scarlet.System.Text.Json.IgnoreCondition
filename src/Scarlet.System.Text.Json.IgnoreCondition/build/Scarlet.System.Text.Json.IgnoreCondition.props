<Project>

  <PropertyGroup>
    <!-- Emit a module initializer that registers the annotated types. Set to false to call
         ScarletIgnoreConditions.Register() by hand instead. -->
    <ScarletJsonIgnoreConditionAutoRegister Condition="'$(ScarletJsonIgnoreConditionAutoRegister)' == ''">true</ScarletJsonIgnoreConditionAutoRegister>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ScarletJsonIgnoreConditionAutoRegister" />
  </ItemGroup>

  <!--
    ScarletJsonIgnoreConditionGenerator=false disables the compile-time registry generator. The
    library then falls back to reading [JsonIgnoreEx] by reflection at contract-resolution time,
    which is not NativeAOT/trim clean. See docs/limitations.md.
  -->
  <Target Name="RemoveScarletJsonIgnoreConditionGenerator"
          BeforeTargets="CoreCompile"
          Condition="'$(ScarletJsonIgnoreConditionGenerator)' == 'false'">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Filename)' == 'Scarlet.System.Text.Json.IgnoreCondition.SourceGeneration'" />
    </ItemGroup>
  </Target>

</Project>
