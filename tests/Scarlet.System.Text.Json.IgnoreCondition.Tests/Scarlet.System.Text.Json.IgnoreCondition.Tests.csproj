<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <!-- Some models carry these conflicts on purpose, to test how the runtime handles them. -->
    <NoWarn>$(NoWarn);SJI0001;SJI0002</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NativeAotTests)' == 'true'">
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <DefineConstants>$(DefineConstants);NATIVE_AOT_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(NativeAotTests)' == 'true'">
    <!-- These tests intentionally exercise reflection-only contracts absent from the contexts. -->
    <Compile Remove="GuardRailTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scarlet.System.Text.Json.IgnoreCondition\Scarlet.System.Text.Json.IgnoreCondition.csproj" />
    <!-- The package delivers the analyzer assembly, and with it the registration generator, to consumers;
         a project reference to the library does not flow it, so reference it as a consumer would get it. -->
    <ProjectReference Include="..\..\src\Scarlet.System.Text.Json.IgnoreCondition.Analyzers\Scarlet.System.Text.Json.IgnoreCondition.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Root the whole library so AOT publish analyzes every method, not only the ones tests touch. -->
	<TrimmerRootAssembly Include="Scarlet.System.Text.Json.IgnoreCondition" />
  </ItemGroup>

</Project>
